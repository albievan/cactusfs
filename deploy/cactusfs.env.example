# CactusFS - every setting of "cactusfs server", as an environment file.
#
# Printed by "cactusfs config --format env"; "make settings-docs" writes this
# file, and a test fails when the two differ. Do not edit it by hand.
#
# Copy it to a file of your own, outside the repository or under a name git
# ignores (.env, .env.*, *.env), and take the "#" off the lines you set.
# Every line is commented out, so the copy changes nothing until you do. The
# server reads its environment and no file: hand the file to whatever starts
# it -
#
#   docker run --env-file cactusfs.env ...
#   EnvironmentFile=/etc/cactusfs/cactusfs.env        (a systemd unit)
#   a shell, PowerShell: the loops of README.md, "An environment file"
#
# A line is NAME=value, and the value is everything after the first "=" as
# it stands: write it without quotes around it, on one line, with no comment
# after it. A shell that sources the file reads it otherwise - a space, a
# "$" or a quote in a value means something to it - which is why README.md
# has a loop instead.
#
# Each variable has a flag of the same name (CACTUSFS_S3_ADDR is --s3-addr),
# and the flag wins. A variable that is set to nothing counts as not set.
#
# SECRETS DO NOT BELONG IN THIS FILE. The lines of a secret are here so that
# the list is whole: give the value from a secret store (a Kubernetes Secret,
# the engine's secrets, the environment of the service manager). A line that
# names a file that holds a secret takes the path; keep that file outside the
# repository, readable by the node alone. Neither is ever committed.

# ---- Listeners: where clients reach the node ----

# listen address of the S3 API
# Flag: --s3-addr. Default: :9000
#CACTUSFS_S3_ADDR=:9000

# listen address of the admin listener
# Flag: --admin-addr. Default: :9001
#CACTUSFS_ADMIN_ADDR=:9001

# domain for virtual-hosted-style requests, <bucket>.<domain>
# Flag: --s3-domain. No default.
#CACTUSFS_S3_DOMAIN=

# region name reported to S3 clients; default us-east-1
# Flag: --region. No default.
#CACTUSFS_REGION=

# on shutdown, keep serving this long with /readyz answering 503 before
# closing the listeners
# Flag: --drain-delay. Default: 0s
#CACTUSFS_DRAIN_DELAY=0s

# time allowed for in-flight requests to finish once the listeners have closed
# Flag: --shutdown-timeout. Default: 30s
#CACTUSFS_SHUTDOWN_TIMEOUT=30s

# ---- Storage: drives and the metadata directory ----

# drive directory; repeat the flag or separate directories with commas
# Flag: --data. No default.
#CACTUSFS_DATA=

# what the deployment calls the volume behind each drive directory - a compose
# volume, a claim - as labels separated by commas, one for each --data entry
# in the same order, or none; shown with the node's settings and used for
# nothing else
# Flag: --drive-labels. No default.
#CACTUSFS_DRIVE_LABELS=

# metadata directory; default <first data directory>/meta
# Flag: --meta-dir. No default.
#CACTUSFS_META_DIR=

# confirm that one empty drive replaces one missing drive at this start;
# permanent: the missing drive is refused afterwards
# Flag: --allow-drive-replacement. Default: false
#CACTUSFS_ALLOW_DRIVE_REPLACEMENT=false

# ---- Cluster: the node among its peers ----

# name of this node: lowercase letters, digits and hyphens; required in a
# cluster, where it must be the name in the node certificate
# Flag: --node-id. No default.
#CACTUSFS_NODE_ID=

# roles of this node: gateway, meta, storage, console; default all
# Flag: --roles. No default.
#CACTUSFS_ROLES=

# every node of the cluster, this one included, as id=host:port of its node
# RPC, separated by commas; makes the node a member of a cluster
# Flag: --peers. No default.
#CACTUSFS_PEERS=

# listen address of node RPC
# Flag: --rpc-addr. Default: :9002
#CACTUSFS_RPC_ADDR=:9002

# listen address of the Raft transport
# Flag: --raft-addr. Default: :9003
#CACTUSFS_RAFT_ADDR=:9003

# host:port at which other nodes reach this node's RPC; default its entry in
# --peers
# Flag: --advertise-rpc. No default.
#CACTUSFS_ADVERTISE_RPC=

# host:port at which other nodes reach this node's Raft transport; default the
# host of --advertise-rpc with the port of --raft-addr
# Flag: --advertise-raft. No default.
#CACTUSFS_ADVERTISE_RAFT=

# region this node is in, for placement
# Flag: --topology-region. No default.
#CACTUSFS_TOPOLOGY_REGION=

# zone this node is in, for placement
# Flag: --topology-zone. No default.
#CACTUSFS_TOPOLOGY_ZONE=

# rack this node is in, for placement
# Flag: --topology-rack. No default.
#CACTUSFS_TOPOLOGY_RACK=

# host this node runs on, for placement
# Flag: --topology-host. No default.
#CACTUSFS_TOPOLOGY_HOST=

# ---- TLS: certificates of the listeners and of the node ----

# path of the PEM certificate chain
# Flag: --tls-cert. No default.
#CACTUSFS_TLS_CERT=

# path of the PEM private key
# Flag: --tls-key. The path of a file that holds a secret: keep the file
# outside the repository; it is never committed.
#CACTUSFS_TLS_KEY=

# how often the certificate and key files, the node's too, are read again, so
# that a certificate is replaced without a restart; at least 5s, 0 never reads
# them again; the node CA is read at start only
# Flag: --tls-reload-interval. Default: 1m
#CACTUSFS_TLS_RELOAD_INTERVAL=1m

# DEVELOPMENT ONLY: serve HTTP without TLS, on a loopback IP address only
# Flag: --dev-plaintext. Default: false
#CACTUSFS_DEV_PLAINTEXT=false

# path of the node certificate for mutual TLS between nodes
# Flag: --node-tls-cert. No default.
#CACTUSFS_NODE_TLS_CERT=

# path of the node certificate's private key
# Flag: --node-tls-key. The path of a file that holds a secret: keep the file
# outside the repository; it is never committed.
#CACTUSFS_NODE_TLS_KEY=

# path of the CA certificate that issues the cluster's node certificates, and
# nothing else
# Flag: --node-tls-ca. No default.
#CACTUSFS_NODE_TLS_CA=

# ---- KMS: the key that wraps data keys ----

# key management service: "vault" for HashiCorp Vault Transit, "local" for a
# sealed local key file; there is no default
# Flag: --kms. No default.
#CACTUSFS_KMS=

# path of the local KMS key file; default <metadata directory>/kms-local.json
# Flag: --kms-key-file. The path of a file that holds a secret: keep the file
# outside the repository; it is never committed.
#CACTUSFS_KMS_KEY_FILE=

# passphrase that opens the local KMS key file
# A secret, and so without a flag: set it from a secret store, never in a file
# that is committed.
#CACTUSFS_KMS_PASSPHRASE=

# path of a file holding the local KMS passphrase, instead of
# $CACTUSFS_KMS_PASSPHRASE
# Flag: --kms-passphrase-file. The path of a file that holds a secret: keep
# the file outside the repository; it is never committed.
#CACTUSFS_KMS_PASSPHRASE_FILE=

# URL of Vault, https://host:port
# Flag: --vault-addr. No default.
#CACTUSFS_VAULT_ADDR=

# path of Vault's Transit engine; default transit
# Flag: --vault-transit-mount. No default.
#CACTUSFS_VAULT_TRANSIT_MOUNT=

# name of the Transit key, of an AEAD type such as aes256-gcm96
# Flag: --vault-key. No default.
#CACTUSFS_VAULT_KEY=

# path of a file holding the Vault token; read at every use, so it can be
# renewed in place
# Flag: --vault-token-file. The path of a file that holds a secret: keep the
# file outside the repository; it is never committed.
#CACTUSFS_VAULT_TOKEN_FILE=

# path of the CA certificate that issued Vault's certificate; default the
# system's CAs
# Flag: --vault-ca-cert. No default.
#CACTUSFS_VAULT_CA_CERT=

# name expected in Vault's certificate, when Vault is reached under another
# Flag: --vault-server-name. No default.
#CACTUSFS_VAULT_SERVER_NAME=

# Vault Enterprise namespace
# Flag: --vault-namespace. No default.
#CACTUSFS_VAULT_NAMESPACE=

# ---- Bootstrap: the root credentials of a new deployment ----

# access key ID of the root credentials a new deployment begins with; set it
# together with $CACTUSFS_ROOT_SECRET_KEY
# A secret, and so without a flag: set it from a secret store, never in a file
# that is committed.
#CACTUSFS_ROOT_ACCESS_KEY=

# secret key of the root credentials a new deployment begins with; set it
# together with $CACTUSFS_ROOT_ACCESS_KEY
# A secret, and so without a flag: set it from a secret store, never in a file
# that is committed.
#CACTUSFS_ROOT_SECRET_KEY=

# ---- Maintenance: background work ----

# pause between two passes of the scrubber, which verifies and heals every
# object; 0 disables it
# Flag: --scrub-interval. Default: 24h
#CACTUSFS_SCRUB_INTERVAL=24h

# limit on how fast the scrubber reads, in MiB per second; 0 is no limit
# Flag: --scrub-rate-mib. Default: 64
#CACTUSFS_SCRUB_RATE_MIB=64

# pause between two passes of the worker that carries out the lifecycle rules
# of buckets; 0 disables it
# Flag: --lifecycle-interval. Default: 1h
#CACTUSFS_LIFECYCLE_INTERVAL=1h

# pause between two passes of the garbage collector for unreferenced shards; 0
# disables it
# Flag: --gc-interval. Default: 1h
#CACTUSFS_GC_INTERVAL=1h

# minimum age of an unreferenced shard before it is removed
# Flag: --gc-grace. Default: 24h
#CACTUSFS_GC_GRACE=24h

# how often the downloads this node counted are recorded with the objects, at
# least 5s; a node that crashes loses up to this much of the count
# Flag: --access-flush-interval. Default: 30s
#CACTUSFS_ACCESS_FLUSH_INTERVAL=30s

# ---- Observability: log, audit export and traces ----

# minimum log level: debug, info, warn or error
# Flag: --log-level. Default: info
#CACTUSFS_LOG_LEVEL=info

# write every audit record to standard output as a JSON line with
# "stream":"audit"
# Flag: --audit-export. Default: false
#CACTUSFS_AUDIT_EXPORT=false

# URL of an OTLP/HTTP trace collector; traces are not exported when empty
# Flag: --otlp-endpoint. No default.
#CACTUSFS_OTLP_ENDPOINT=
