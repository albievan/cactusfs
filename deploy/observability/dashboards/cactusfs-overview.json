          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Goroutines",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
